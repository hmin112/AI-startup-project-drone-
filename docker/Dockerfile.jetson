# Jetson (JetPack 6 / L4T R36) 배포용 이미지
#
# dusty-nv jetson-containers 프로젝트가 배포하는 ROS 2 Humble 이미지를 베이스로 사용합니다.
# 이 이미지는 flashed JetPack 버전(L4T)에 맞는 CUDA / cuDNN / TensorRT가 이미 포함되어 있어
# vision_ai 패키지의 TensorRT 추론과 바로 호환됩니다.
#
# 베이스 이미지 태그는 실제 Jetson에 설치된 JetPack 버전에 맞춰 --build-arg 로 지정하세요.
# Jetson에서 아래 명령으로 정확한 L4T 버전을 확인할 수 있습니다:
#   cat /etc/nv_tegra_release
#
# 예)
#   JetPack 6.0  -> l4t-r36.3.0
#   JetPack 6.1  -> l4t-r36.4.0
#   JetPack 6.2  -> l4t-r36.4.3
# (정확한 태그 목록은 https://hub.docker.com/r/dustynv/ros/tags 에서 확인)
ARG BASE_IMAGE=dustynv/ros:humble-desktop-l4t-r36.3.0
FROM ${BASE_IMAGE}

SHELL ["/bin/bash", "-c"]

ENV ROS_WS=/bridge_drone_ws
WORKDIR ${ROS_WS}

# 워크스페이스 소스만 복사 (build/install/log, 모델 가중치는 .dockerignore로 제외)
COPY src ./src
COPY launch ./launch

# 패키지 의존성 설치 (mavros_msgs, cv_bridge, sensor_msgs, nav_msgs 등)
RUN apt-get update && \
    rosdep update && \
    rosdep install --from-paths src --ignore-src -r -y && \
    rm -rf /var/lib/apt/lists/*

RUN source /opt/ros/humble/setup.bash && \
    colcon build --symlink-install

COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["ros2", "launch", "launch/bridge_drone.launch.py"]
